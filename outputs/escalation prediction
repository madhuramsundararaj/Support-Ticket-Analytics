   "source": [
    "# Define escalation risk label\n",
    "# Frustration score >= 20 = will escalate\n",
    "df['will_escalate'] = (df['frustration_score'] >= 20).astype(int)\n",
    "\n",
    "print(\"Escalation distribution:\")\n",
    "print(df['will_escalate'].value_counts())\n",
    "print(\"\\nEscalation rate:\", round(df['will_escalate'].mean() * 100, 2), \"%\")\n"
   ]
