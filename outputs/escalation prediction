   "source": [
    "# Fix - use only truly independent features\n",
    "# Remove frustration_score and priority_score since they created will_escalate\n",
    "\n",
    "features_clean = ['priority_encoded', 'channel_encoded', \n",
    "                  'type_encoded', 'Customer Age',\n",
    "                  'Customer Satisfaction Rating']\n",
    "\n",
    "# Fill missing satisfaction with 0\n",
    "df['Customer Satisfaction Rating'] = df['Customer Satisfaction Rating'].fillna(0)\n",
    "\n",
    "X_clean = df[features_clean]\n",
    "y = df['will_escalate']\n",
    "\n",
    "# Split data\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X_clean, y, test_size=0.2, random_state=42)\n",
    "\n",
    "# Train model\n",
    "model_clean = RandomForestClassifier(n_estimators=100, random_state=42)\n",
    "model_clean.fit(X_train, y_train)\n",
    "\n",
    "# Evaluate\n",
    "y_pred_clean = model_clean.predict(X_test)\n",
    "print(\"Model Performance - Clean Features:\")\n",
    "print(classification_report(y_test, y_pred_clean))\n",
    "\n",
    "# Feature importance\n",
    "importance = pd.DataFrame({\n",
    "    'feature': features_clean,\n",
    "    'importance': model_clean.feature_importances_\n",
    "}).sort_values('importance', ascending=False)\n",
    "\n",
    "print(\"\\nFeature Importance:\")\n",
    "print(importance)"
   ]
