    "# Query 1 - Ticket volume and resolution rate by priority\n",
    "query1 = \"\"\"\n",
    "SELECT \n",
    "    \"Ticket Priority\",\n",
    "    COUNT(*) as total_tickets,\n",
    "    SUM(is_resolved) as resolved_tickets,\n",
    "    ROUND(100.0 * SUM(is_resolved) / COUNT(*), 2) as resolution_rate_pct,\n",
    "    ROUND(AVG(frustration_score), 2) as avg_frustration\n",
    "FROM tickets\n",
    "GROUP BY \"Ticket Priority\"\n",
    "ORDER BY avg_frustration DESC;\n",
    "\"\"\"\n",
    "\n",
    "result1 = pd.read_sql_query(query1, conn)\n",
    "print(\"Query 1 - Resolution Rate by Priority\")\n",
    "print(result1)\n",
    "result1.to_csv('/Users/madhuramdhanesh/Downloads/resolution_by_priority.csv', index=False)"
