    "# Query 5 - Ticket trends using LAG window function\n",
    "query5 = \"\"\"\n",
    "WITH monthly_tickets AS (\n",
    "    SELECT \n",
    "        substr(\"Date of Purchase\", 1, 7) as month,\n",
    "        COUNT(*) as total_tickets,\n",
    "        SUM(is_resolved) as resolved_tickets,\n",
    "        ROUND(AVG(frustration_score), 2) as avg_frustration\n",
    "    FROM tickets\n",
    "    GROUP BY substr(\"Date of Purchase\", 1, 7)\n",
    ")\n",
    "SELECT \n",
    "    month,\n",
    "    total_tickets,\n",
    "    resolved_tickets,\n",
    "    avg_frustration,\n",
    "    LAG(total_tickets) OVER (ORDER BY month) as prev_month_tickets,\n",
    "    total_tickets - LAG(total_tickets) OVER (ORDER BY month) as month_over_month_change\n",
    "FROM monthly_tickets\n",
    "ORDER BY month;\n",
    "\"\"\"\n",
    "\n",
    "result5 = pd.read_sql_query(query5, conn)\n",
    "print(\"Query 5 - Monthly Ticket Trends\")\n",
    "print(result5)\n",
    "result5.to_csv('/Users/madhuramdhanesh/Downloads/monthly_trends.csv', index=False)"
