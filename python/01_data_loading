   "source": [
    "# Create Resolution Time in hours (numeric)\n",
    "df['resolution_hours'] = (\n",
    "    df['Time to Resolution'] - df['First Response Time']\n",
    ").dt.total_seconds() / 3600\n",
    "\n",
    "# Create Frustration Score\n",
    "# High priority + low satisfaction + long resolution = high frustration\n",
    "priority_score = {'Critical': 4, 'High': 3, 'Medium': 2, 'Low': 1}\n",
    "df['priority_score'] = df['Ticket Priority'].map(priority_score)\n",
    "\n",
    "# Normalize satisfaction (missing = worst case = 0)\n",
    "df['satisfaction_score'] = df['Customer Satisfaction Rating'].fillna(0)\n",
    "\n",
    "# Frustration Score formula\n",
    "df['frustration_score'] = (\n",
    "    df['priority_score'] * 2 +\n",
    "    (5 - df['satisfaction_score']) * 3\n",
    ").round(2)\n",
    "\n",
    "print(\"Frustration Score created\")\n",
    "print(\"\\nFrustration Score summary:\")\n",
    "print(df['frustration_score'].describe())\n",
    "\n",
    "print(\"\\nTop 5 most frustrated customers:\")\n",
    "print(df[['Customer Name', 'Ticket Priority', \n",
    "          'Customer Satisfaction Rating',\n",
    "          'frustration_score']].sort_values(\n",
    "          'frustration_score', ascending=False).head())"
   ]
