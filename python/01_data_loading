   "source": [
    "# Convert date columns to proper datetime format\n",
    "df['Date of Purchase'] = pd.to_datetime(df['Date of Purchase'])\n",
    "df['First Response Time'] = pd.to_datetime(df['First Response Time'], errors='coerce')\n",
    "df['Time to Resolution'] = pd.to_datetime(df['Time to Resolution'], errors='coerce')\n",
    "\n",
    "# Create a flag for resolved tickets\n",
    "df['is_resolved'] = df['Ticket Status'].apply(lambda x: 1 if x == 'Closed' else 0)\n",
    "\n",
    "# Create SLA breach flag\n",
    "# Critical tickets should be resolved within 24 hours\n",
    "# High within 48 hours, Medium within 72 hours, Low within 96 hours\n",
    "sla_limits = {\n",
    "    'Critical': 24,\n",
